# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=add_ur_database_url
POSTGRES_PASSWORD=add_ur_password

# ── Auth ───────────────────────────────────────────────────────────────────
# Random 64-char hex string — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_hex_string
VAULT_MASTER_SECRET=change_me_to_a_different_random_64_char_hex_string

# ── AI model (Groq, OpenAI-compatible) ─────────────────────────────────────
# The deployment agent and the repo scanner both call Groq chat completions.
GROQ_API_KEY=
AGENT_MODEL=llama-3.3-70b-versatile
SCAN_MODEL=llama-3.3-70b-versatile

# ── Chain / RPC ────────────────────────────────────────────────────────────
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer wallet — used by scripts/deploy-contracts.sh and scripts/register-provider.sh
DEPLOYER_PRIVATE_KEY=

# Agent wallet — the autonomous wallet the backend uses to fund escrow, attest
# execution proofs and settle provider payments. Fund it from the Monad faucet:
# https://faucet.monad.xyz
AGENT_WALLET_PRIVATE_KEY=

# How much native MON the agent locks in escrow for the provider, per session.
ESCROW_DEPOSIT_MON=0.01

# ── Deployed contract addresses (fill after scripts/deploy-contracts.sh) ───
PROVIDER_REGISTRY_ADDRESS=
DEPLOYMENT_ESCROW_ADDRESS=
JOB_AUCTION_ADDRESS=
EXECUTION_ATTESTATION_ADDRESS=

# ── Contract verification (MonadScan, optional) ────────────────────────────
MONADSCAN_API_KEY=

# ── EAS (legacy) ───────────────────────────────────────────────────────────
# Superseded by the ExecutionAttestation contract; the backend no longer reads
# these. Only scripts/register-eas-schema.sh still uses them.
EAS_CONTRACT_ADDRESS=
EAS_SCHEMA_REGISTRY_ADDRESS=

# ── 0G Network — decentralized agent memory ─────────────────────────────────
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_PRIVATE_KEY=
ZG_FLOW_ADDRESS=

# ── Gensyn AXL — cross-node agent messaging ────────────────────────────────
# AXL_ENDPOINT is the local AXL node API (e.g. http://127.0.0.1:9002);
# AXL_PEER_ID is the destination peer's 64-char hex ed25519 public key.
# Both must be set for agent-to-agent subtask delegation; otherwise it no-ops.
AXL_ENDPOINT=
AXL_PEER_ID=

# ── KeeperHub — on-chain execution reliability ─────────────────────────────
KEEPERHUB_ENDPOINT=
KEEPERHUB_PRIVATE_KEY=

# ── Local/demo only ────────────────────────────────────────────────────────
# Bypasses the x402 paywall in front of session creation so you can run the app
# without USDC. Never set this true on a public deployment.
PAYMENTS_DISABLED=false

# ── Provider mode (for nodes that act as compute providers) ────────────────
# Set PROVIDER_MODE=true on provider nodes; they will auto-watch and bid on job auctions.
PROVIDER_MODE=false
# Provider's own registered wallet private key (different from AGENT_WALLET_PRIVATE_KEY)
PROVIDER_WALLET_PRIVATE_KEY=

# ── GitHub OAuth (repo picker on /deploy) ──────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/github/callback  (or your production URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# ── Docker ─────────────────────────────────────────────────────────────────
DOCKER_HOST=tcp://localhost:2375

# ── Backend server ─────────────────────────────────────────────────────────
PORT=8080
# Subdomain used for deployed container workspaces (e.g. *.deploy.meta-max.xyz)
DEPLOY_DOMAIN=


# ── Frontend (Next.js — copy relevant vars to frontend/.env.local) ─────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Fill from contracts/deployments.json after deploy-contracts.sh
NEXT_PUBLIC_PROVIDER_REGISTRY_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_ESCROW_ADDRESS=
NEXT_PUBLIC_JOB_AUCTION_ADDRESS=
NEXT_PUBLIC_EXECUTION_ATTESTATION_ADDRESS=
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Change if another app occupies localhost:8080
BACKEND_HOST_PORT=8080
